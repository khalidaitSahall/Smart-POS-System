# Copy this file to .env and fill in local configuration values.
# For the web backend, configure a PostgreSQL connection URL.
DATABASE_URL=postgresql://postgres:password@localhost:5432/smart_pos
API_PORT=3000
# Set true if your hosted PostgreSQL provider requires SSL.
PGSSL=false
# Comma-separated allowed origins for a separately hosted frontend; same-origin hosting is recommended.
CORS_ORIGIN=http://localhost:5173
